# ═══════════════════════════════════════════════
# Acessilia Structure Extractor — Configuração
# ═══════════════════════════════════════════════
#
# Copie este arquivo para .env e ajuste os valores:
#   cp .env.example .env
#
# O arquivo .env é carregado automaticamente pelo
# Docker Compose e lido pela CLI via os.environ.

# ─── docling-serve ─────────────────────────────

# URL base do servidor docling-serve.
# Usado pela CLI e pelos testes para extração remota.
# Exemplos:
#   http://localhost:5001           (execução local)
#   http://docling-serve:5001       (Docker Compose)
DOCLING_SERVE_URL=http://localhost:5001
DOCLING_SERVE_IMAGE=ghcr.io/docling-project/docling-serve-cpu:v1.32.0
DOCLING_SERVE_PORT=5001

# ─── docling-serve (container) ─────────────────

# Desabilita a interface web do docling-serve.
# Apenas relevante quando executado via Docker.
DOCLING_SERVE_ENABLE_UI=false

# ─── Acessilia Extractor ───────────────────────

# Idioma BCP 47 padrão para extração.
# Sobrescreve o padrão "pt-BR" da CLI.
# EXTRACTOR_LANGUAGE=en-US